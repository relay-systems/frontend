# Dependencies (package-lock.json stays tracked)
node_modules/

# Build output and Angular caches
dist/
out-tsc/
.angular/
*.tsbuildinfo

# Test and coverage output
coverage/
__screenshots__/
testem.log

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local secrets (the example file is the only tracked env file)
.env
.env.*
!.env.example

# OS / IDE
.DS_Store
.idea/
.vscode/

# Shared AI tooling (symlinks to ../ai, never committed)
/CLAUDE.md
/.claude
/.serena/
/graphify-out/
